<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RecycleScan3" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.RecycleScan3" parent="Base.Theme.RecycleScan3" />
    <!-- ── Root containers ───────────────────────────────────────────────────── -->
    <style name="Widget.RecyclScan.RootLayout">
        <item name="android:background">?attr/colorBackground</item>
    </style>

    <style name="Widget.RecyclScan.ScrollView">
        <item name="android:background">?attr/colorBackground</item>
    </style>

    <!-- ── Category card ─────────────────────────────────────────────────────── -->
    <style name="Widget.RecyclScan.CategoryCard">
        <item name="android:background">?attr/colorSurface</item>
        <!-- android:background="@drawable/bg_category_card" once we create it -->
        <item name="android:elevation">4dp</item>
    </style>

    <!-- ── Text appearances ───────────────────────────────────────────────────── -->
    <style name="TextAppearance.RecyclScan.ProductName" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>

    <style name="TextAppearance.RecyclScan.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.RecyclScan.CategoryEmoji" parent="TextAppearance.Material3.DisplaySmall">
    </style>

    <style name="TextAppearance.RecyclScan.CategoryLabel" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.RecyclScan.SectionHeader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.RecyclScan.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- ── Button ────────────────────────────────────────────────────────────── -->
    <style name="Widget.RecyclScan.Button.Primary" parent="Widget.Material3.Button">
    </style>

</resources>