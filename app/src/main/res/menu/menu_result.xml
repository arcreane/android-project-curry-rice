<?xml version="1.0" encoding="utf-8"?>
<!--
    menu_result.xml
    Options menu for ResultActivity (R4 — wired to real actions).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Share result via implicit Intent (R1) -->
    <item
        android:id="@+id/action_share"
        android:icon="@drawable/ic_share"
        android:title="@string/menu_share"
        app:showAsAction="ifRoom" />

    <!-- Save to local history (wired to ContentProvider stub, R8) -->
    <item
        android:id="@+id/action_add_history"
        android:title="@string/menu_add_history"
        app:showAsAction="never" />

</menu>
