<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_result.xml — PORTRAIT
    All colours come from styles/themes; no hard-coded colour values (R6).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    style="@style/Widget.RecyclScan.ScrollView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- ── Product name ─────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_product_name"
            style="@style/TextAppearance.RecyclScan.ProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/placeholder_product_name" />

        <!-- ── Barcode ───────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_barcode"
            style="@style/TextAppearance.RecyclScan.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/label_barcode_unknown" />

        <!-- ── Category card ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layout_category_card"
            style="@style/Widget.RecyclScan.CategoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <TextView
                android:id="@+id/tv_category_emoji"
                style="@style/TextAppearance.RecyclScan.CategoryEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♻️" />

            <TextView
                android:id="@+id/tv_category_label"
                style="@style/TextAppearance.RecyclScan.CategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/placeholder_category" />

        </LinearLayout>

        <!-- ── Instructions ──────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_instructions_header"
            style="@style/TextAppearance.RecyclScan.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xsmall"
            android:text="@string/header_instructions" />

        <TextView
            android:id="@+id/tv_instructions"
            style="@style/TextAppearance.RecyclScan.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xlarge"
            android:text="@string/label_no_instructions" />

        <!-- ── Scan again button ──────────────────────────────────────────── -->
        <Button
            android:id="@+id/btn_scan_again"
            style="@style/Widget.RecyclScan.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_scan_again" />

    </LinearLayout>
</ScrollView>
